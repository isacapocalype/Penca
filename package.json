{
  "name": "penca",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Penca — dashboard keuangan konveksi offline-first",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
